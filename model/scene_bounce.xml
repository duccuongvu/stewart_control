<mujoco model="stewart ball bouncing scene">
  <include file="platform.xml"/>

  <statistic center="0 0 1.3" extent="1.4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <camera name="track" pos="1.8 -1.8 2.4" mode="targetbody" target="upper"/>

    <!-- Elastic ball dropped onto the tray. The demo pumps a vertical platform
         reference to sustain the bounce while keeping the ball centred. solref
         dampratio 0.15 gives a lively but stable rebound; lower values inject
         energy on tilted contacts and the ball flies off. -->
    <body name="ball" pos="0.05 0.04 1.6">
      <freejoint name="ball_joint"/>
      <geom name="ball" type="sphere" size="0.03" rgba="0.95 0.55 0.1 1" mass="0.05"
            priority="1" contype="1" conaffinity="1"
            solimp="0.95 0.95 0.01" solref="0.01 0.15" friction="0.4 0.01 0.001"/>
      <site name="ball_site" type="sphere" size="0.014"/>
    </body>
  </worldbody>

  <sensor>
    <framepos name="ball_position" objtype="site" objname="ball_site" reftype="site" refname="plane_site"/>
    <framelinvel name="ball_velocity" objtype="site" objname="ball_site" reftype="site" refname="plane_site"/>
  </sensor>
</mujoco>
